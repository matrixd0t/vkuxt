[Unit]
Description=Profile form VK bot (vkuxt example)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/profile-form
EnvironmentFile=/opt/profile-form/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/profile-form/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8099 --no-access-log --proxy-headers
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/profile-form/data

[Install]
WantedBy=multi-user.target
